# Kosong → PGlite di .data/pglite (dev). Isi dengan URL Supabase/Postgres untuk produksi.
DATABASE_URL=
JWT_SECRET=ganti-dengan-rahasia-panjang
# Opsional: aktifkan mode LLM Sovia
ANTHROPIC_API_KEY=
STORAGE_DRIVER=local
API_URL=http://localhost:4000
PORT=4000
# Hanya bila STORAGE_DRIVER=supabase (bucket privat)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=skin-photos
# Basis URL API yang bisa dijangkau browser (untuk foto di console)
API_PUBLIC_URL=http://localhost:4000

# Dispatcher webhook (Vercel Cron memanggil /v1/internal/dispatch dengan Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# 32 byte (64 hex atau base64): mengenkripsi rahasia webhook saat disimpan. Buat: openssl rand -hex 32
ENCRYPTION_KEY=
# MCP (apps/mcp)
AEVIA_API_URL=http://localhost:4000
AEVIA_API_KEY=

# Mode LLM Sovia (opsional): model Claude yang dipakai. Default claude-sonnet-5-5 (id model mengikuti SDK Anthropic).
ANTHROPIC_MODEL=
# Email OTP (produksi wajib): Resend. Tanpa ini kode OTP hanya tampil di log (dev).
# Pengirim OTP: isi salah satu (Mailketing diutamakan)
MAILKETING_API_TOKEN=
RESEND_API_KEY=
OTP_FROM_EMAIL=
# Web: host platform yang TIDAK dipetakan sebagai domain klinik (pisahkan koma)
PLATFORM_HOSTS=localhost,127.0.0.1
