{
  "name": "aevia",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke": "pnpm --filter @aevia/web smoke",
    "db:migrate": "pnpm --filter @aevia/db migrate",
    "db:seed": "pnpm --filter @aevia/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
